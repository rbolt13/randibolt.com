# 1) Make bigram tokens per doc and collapse back to a single string
sw <- stop_words$word
bigrams_text <- Data %>%
select(doc, lyrics) %>%
mutate(lyrics = tolower(lyrics)) %>%
unnest_tokens(bigram, lyrics, token = "ngrams", n = 2) %>%
separate(bigram, c("w1","w2"), sep = " ", remove = TRUE) %>%
filter(!(w1 %in% sw | w2 %in% sw)) %>%     # drop bigrams that include a stop word
mutate(tok = paste(w1, w2, sep = "_")) %>% # keep bigrams as one token
group_by(doc) %>%
summarise(lyrics = paste(tok, collapse = " "), .groups = "drop")
